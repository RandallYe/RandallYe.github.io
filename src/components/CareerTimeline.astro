---
const milestones = [
  {
    start: '2025-11', startLabel: 'Nov 2025', end: undefined, endLabel: 'Present',
    category: 'Industry', title: 'Formal Methods Engineer', organisation: 'IOHK',
    summary: 'Moved into industry after research at the University of York.',
    url: 'https://iohk.io/', linkLabel: 'IOHK',
  },
  {
    start: '2016', startLabel: '2016', end: '2025', endLabel: '2025',
    category: 'Research', title: 'Formal methods research', organisation: 'University of York',
    summary: 'Research in robotics, probabilistic programming and security, connecting formal semantics with model checking, theorem proving and tool development.',
  },
  {
    start: '2012', startLabel: '2012', end: '2016', endLabel: '2016',
    category: 'Education', title: 'PhD in Formal Methods', organisation: 'University of York',
    summary: 'Supervised by Prof. Jim Woodcock. Investigated model checking of state-rich formalisms by linking state-based specifications and process algebra.',
    url: 'https://etheses.whiterose.ac.uk/15526/', linkLabel: 'Read the PhD thesis',
  },
  {
    start: '2004', startLabel: '2004', end: '2012', endLabel: '2012',
    category: 'Industry', title: 'Embedded Software Engineer / Team Lead', organisation: 'Embedded systems',
    summary: 'Led teams of 4–8 engineers developing software for lithography, Ethernet datacentre switches and communications devices. Worked with C/C++, microcontrollers, Linux and VxWorks.',
  },
];
---
<ol class="career-timeline" role="list" aria-label="Career and education, most recent first">
  {milestones.map((milestone, index) => (
    <li class:list={['milestone', { 'milestone-current': index === 0 }]}>
      <div class="milestone-period">
        <time datetime={milestone.start}>{milestone.startLabel}</time>
        <span aria-hidden="true"> — </span><span class="sr-only"> to </span>
        {milestone.end ? <time datetime={milestone.end}>{milestone.endLabel}</time> : <span>{milestone.endLabel}</span>}
      </div>
      <div class="milestone-content">
        <p class="eyebrow">{milestone.category}{index === 0 && <span class="current-label">Current</span>}</p>
        <h3>{milestone.title}</h3>
        <p class="organisation">{milestone.organisation}</p>
        <p class="milestone-summary">{milestone.summary}</p>
        {milestone.url && <a class="text-link" href={milestone.url}>{milestone.linkLabel} <span aria-hidden="true">↗</span></a>}
      </div>
    </li>
  ))}
</ol>
<style>
  .career-timeline {
    list-style: none;
    margin: 2rem 0 2.5rem;
    padding: 0;
  }
  .milestone {
    position: relative;
    display: grid;
    grid-template-columns: 155px minmax(0, 1fr);
    column-gap: 2rem;
    padding: 0 0 2.5rem;
  }
  .milestone::before {
    content: '';
    position: absolute;
    top: .45rem;
    bottom: -.45rem;
    left: 155px;
    width: 1px;
    background: var(--line);
  }
  .milestone::after {
    content: '';
    position: absolute;
    top: .35rem;
    left: 150px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--paper);
  }
  .milestone:last-child { padding-bottom: 0; }
  .milestone:last-child::before { display: none; }
  .milestone-current::after { background: var(--accent); }
  .milestone-period {
    padding-right: .8rem;
    color: var(--muted);
    font-size: .8rem;
    font-variant-numeric: tabular-nums;
  }
  .milestone-content .eyebrow { margin: 0 0 .65rem; }
  .milestone-content h3 { margin: 0 0 .35rem; font-size: 1.25rem; }
  .organisation { margin: 0; font-size: .9rem; font-weight: 600; }
  .milestone-summary { margin: .75rem 0; font-size: .92rem; color: var(--muted); }
  .current-label {
    display: inline-block;
    margin-left: .7rem;
    padding: .1rem .45rem;
    border-radius: 3px;
    background: var(--accent-light);
    font-size: .6rem;
    letter-spacing: .06em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .milestone { grid-template-columns: minmax(0, 1fr); padding-left: 1.7rem; }
    .milestone::before { left: 5px; }
    .milestone::after { left: 0; }
    .milestone-period { margin-bottom: .7rem; }
  }
</style>

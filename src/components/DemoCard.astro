---
import { local } from '../lib/site-paths';
interface Props {
  title: string;
  summary: string;
  url: string;
  kind: string;
  label?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
}
const { title, summary, url, kind, label = 'View source', thumbnail, thumbnailAlt = '' } = Astro.props;
---
<article class="tool-card">
  {thumbnail && <img class="demo-thumbnail" src={local(thumbnail)} alt={thumbnailAlt} width="720" height="423" loading="lazy" decoding="async" />}
  <p class="eyebrow">{kind}</p><h3><a href={local(url)}>{title}</a></h3><p>{summary}</p><a class="text-link" href={local(url)}>{label} <span aria-hidden="true">↗</span></a>
</article>
<style>
  .demo-thumbnail { width: 100%; height: auto; aspect-ratio: 720 / 423; object-fit: contain; border: 1px solid var(--line); border-radius: 3px; margin-bottom: 1.2rem; }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { local } from '../lib/site-paths';
interface Props { demo: CollectionEntry<'demos'>; }
const { demo } = Astro.props;
const d = demo.data;
---
<section class="feature" aria-labelledby="featured-demo-title"><div class="feature-grid"><div><p class="eyebrow">Featured demonstration · Security protocols</p><h2 id="featured-demo-title">Security verification<br />you can explore.</h2><p>{d.summary}</p><div class="actions"><a class="button" href={local(`tools/${d.slug}/#recording`)}>Watch the demonstration <span aria-hidden="true">→</span></a><a class="text-link" href={local(`tools/${d.slug}/`)}>Explore the work →</a></div><div class="feature-resource">{d.paperLinks.map(link => <a href={link.url}>Read paper ↗</a>)}{d.sourceLinks.map(link => <a href={link.url}>View code ↗</a>)}<a href={local(`tools/${d.slug}/#examples`)}>Explore examples →</a></div></div><aside class="feature-side"><p class="eyebrow">SEFM 2024 · Co-authored research</p><strong>{d.title}</strong><p>K. Ye · R. Metere · P. Yadav</p><p>Needham–Schroeder public-key protocol<br />Diffie–Hellman key agreement</p><p class="media-status">Recording linked from MWC2025 news.<br />Playback verification pending.</p></aside></div></section>

---
import { local } from '../lib/paths';
interface Props { title: string; summary: string; id: string; index: number; }
const { title, summary, id, index } = Astro.props;
---
<article class="research-card"><span class="card-number">0{index + 1}</span><h3><a href={local(`research/#${id}`)}>{title}</a></h3><p>{summary}</p><a class="text-link" href={local(`research/#${id}`)}>Explore research <span aria-hidden="true">→</span></a></article>

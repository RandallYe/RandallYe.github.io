---
import { local } from '../lib/site-paths';
interface Props { title: string; summary: string; id: string; index: number; }
const { title, summary, id, index } = Astro.props;
const notation: Record<string, string> = { semantics: '⊢ φ', concurrency: 'P ⊑ Q', security: '{m}ₖ', probability: 'ℙ(X)' };
---
<article class="research-card"><div class="research-card-top"><span class="card-number">0{index + 1} /</span><span class="research-notation" aria-hidden="true">{notation[id]}</span></div><h3><a href={local(`research/${id}/`)}>{title}</a></h3><p>{summary}</p><a class="text-link" href={local(`research/${id}/`)}>Explore research <span aria-hidden="true">→</span></a></article>

        <svg viewBox="0 0 300 140" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5"><rect x="120" y="43" width="60" height="48" rx="9"/><circle cx="136" cy="62" r="4"/><circle cx="164" cy="62" r="4"/><path d="M138 79H162M150 43V29M108 57V80M192 57V80M130 91V104M170 91V104M45 103H97M203 103H255"/><circle cx="150" cy="24" r="5"/><path d="M65 35Q90 65 65 95M235 35Q210 65 235 95" stroke-dasharray="4 5"/></g></svg>

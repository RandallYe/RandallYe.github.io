---
import { local } from '../lib/paths';
interface Props { links: { label: string; url: string }[]; label?: string; }
const { links, label = 'Research resources' } = Astro.props;
const resourceUrl = (url: string) => url.startsWith('https://randallye.github.io/') ? local(url.slice('https://randallye.github.io/'.length)) : url;
---
<ul class="resource-links" aria-label={label}>{links.map(link => <li><a href={resourceUrl(link.url)}>{link.label} <span aria-hidden="true">↗</span></a></li>)}</ul>

---
import { getCollection } from 'astro:content';
import DemoCard from './DemoCard.astro';
import { tools } from '../data/research';
interface Props { limit?: number; }
const { limit } = Astro.props;
const demos = (await getCollection('demos', ({ data }) => !data.featured)).sort((a, b) => a.data.order - b.data.order);
const demoIds = new Set(demos.map(demo => demo.data.slug));
const sourceTools = tools.filter(tool => !tool.demoId || !demoIds.has(tool.demoId));
---
<div class="grid tools-grid">
  {(limit ? demos.slice(0, limit) : demos).map(({ data }) => <DemoCard title={data.title} summary={data.summary} url={`/tools/${data.slug}/`} kind={data.category === 'engineering-case-study' ? 'Engineering case study' : 'Recorded research walkthrough'} label="Watch & explore" thumbnail={data.thumbnail} thumbnailAlt={data.thumbnailAlt} />)}
  {(limit ? sourceTools.slice(0, Math.max(0, limit - demos.length)) : sourceTools).map(tool => <DemoCard {...tool} />)}
</div>

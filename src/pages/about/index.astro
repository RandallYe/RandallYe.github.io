---
import { getCollection } from 'astro:content';
import ResourceLinks from '../../components/ResourceLinks.astro';
import CareerTimeline from '../../components/CareerTimeline.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { local } from '../../lib/site-paths';
const teaching = await getCollection('teaching');
---
<BaseLayout title="About & contact" description="Kangfeng (Randall) Ye: formal methods engineer, former York researcher, career background and contact links.">
  <div class="page-heading"><p class="eyebrow">Research & engineering</p><h1>About Kangfeng (Randall) Ye</h1><p>I am Kangfeng (Randall) Ye. My work brings mathematical reasoning to the design and verification of software systems.</p></div>
  <section class="prose" aria-labelledby="background-title">
    <h2 id="background-title">Background</h2>
    <CareerTimeline />
  </section>
  <div class="prose"><ul class="inline-list"><li><a href={local('downloads/academic-cv.pdf')}>Academic CV (PDF)</a></li><li><a href="https://etheses.whiterose.ac.uk/15526/">PhD thesis</a></li></ul><h2>Research collaborations</h2><p>Past projects include CHEDDAR (2024–2025), SESAME (2023–2024), RoboCalc and RoboTest (2018–2023), CyPhyAssure (2021), control-law diagram reasoning (2017–2018), and INTO-CPS (2016–2017).</p><p>I develop probabilistic verification support for RoboTool and have made selected contributions to Isabelle/UTP. The project histories link related demonstrations and resources.</p><a href={local('research/#projects')}>Explore project history →</a><h2 id="contact">Contact</h2><p>For personal contact: <a href="mailto:ye.randall@gmail.com">ye.randall@gmail.com</a>.</p><ul class="inline-list"><li><a href="https://github.com/RandallYe">GitHub</a></li><li><a href="https://www.linkedin.com/in/randallye">LinkedIn</a></li><li><a href="https://scholar.google.com/citations?hl=en&user=PbLkCR8AAAAJ">Google Scholar</a></li><li><a href="https://dblp.org/pid/193/5774.html">DBLP</a></li></ul></div>
  <section class="section prose" id="teaching"><h2>Teaching & tutorials</h2>{teaching.map(({ data }) => <article><h3>{data.title}</h3><p class="eyebrow">{data.period}</p><p>{data.summary}</p><ResourceLinks links={data.resources} label="Teaching resources" /></article>)}<article><h3>Isabelle/UTP tutorial in Chinese</h3><p>A tutorial given during the May 2019 Royal Society–NSFC joint workshop at Southwest University, Chongqing, based substantially on Simon Foster’s CyPhyAssure Spring School material.</p><a href={local('talks/#isabelle-utp-tutorial-2019')}>Tutorial details and resources →</a></article></section>
</BaseLayout>

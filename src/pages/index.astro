---
import { getCollection } from 'astro:content';
import FeaturedDemo from '../components/FeaturedDemo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyAnchors from '../components/LegacyAnchors.astro';
import Hero from '../components/Hero.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ToolCards from '../components/ToolCards.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import NewsTimeline from '../components/NewsTimeline.astro';
import { research } from '../data/research';
import publications from '../data/publications.json';
import { local } from '../lib/site-paths';
const demos = (await getCollection('demos', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
const selectedIds = ['circus-model-checking', 'proburel', 'robochart-prism'];
const selected = selectedIds.flatMap(id => publications.filter(paper => paper.id === id));
---
<BaseLayout title="Formal methods, from foundations to tools" description="Kangfeng (Randall) Ye researches UTP and Circus, modelling state-rich concurrent systems, refinement checking and probabilistic verification.">
  <LegacyAnchors />
  <Hero />
  {demos.map(demo => <FeaturedDemo demo={demo} />)}
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Connected foundations</p><h2>Research strands</h2></div><a class="text-link" href={local('research/')}>Research overview →</a></div><div class="grid research-grid">{research.map((theme, index) => <ResearchCard {...theme} index={index} />)}</div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Research in action</p><h2>Tools & demonstrations</h2></div><a class="text-link" href={local('tools/')}>All tools & demos →</a></div><ToolCards limit={5} /></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Selected contributions · Co-authored work</p><h2>Publications</h2></div><a class="text-link" href={local('publications/')}>Full publication list →</a></div>{selected.map(paper => <PublicationEntry {...paper} compact />)}</section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Research & career</p><h2>News</h2></div><a class="text-link" href={local('news/')}>All announcements →</a></div><NewsTimeline items={news} compact /></section>
</BaseLayout>

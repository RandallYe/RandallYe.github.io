---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyAnchors from '../components/LegacyAnchors.astro';
import Hero from '../components/Hero.astro';
import ResearchCard from '../components/ResearchCard.astro';
import DemoCard from '../components/DemoCard.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import NewsItem from '../components/NewsItem.astro';
import { research, tools, news } from '../data/research';
import publications from '../data/publications.json';
import { local } from '../lib/paths';
const selected = [publications[0], publications[6], publications[2]];
---
<BaseLayout title="Formal methods, from foundations to tools" description="Kangfeng (Randall) Ye works on formal semantics, theorem proving, probabilistic verification and accessible research tools.">
  <LegacyAnchors />
  <Hero />
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Research in action</p><h2>Tools & demonstrations</h2></div><a class="text-link" href={local('tools/')}>All tools & demos →</a></div><div class="grid tools-grid">{tools.map(tool => <DemoCard {...tool} />)}</div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Connected foundations</p><h2>Research themes</h2></div><a class="text-link" href={local('research/')}>Research overview →</a></div><div class="grid research-grid">{research.map((theme, index) => <ResearchCard {...theme} index={index} />)}</div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Selected contributions · Co-authored work</p><h2>Publications</h2></div><a class="text-link" href={local('publications/')}>Full publication list →</a></div>{selected.map(paper => <PublicationEntry {...paper} />)}</section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">From the research archive</p><h2>News</h2></div><a class="text-link" href={local('legacy/#news')}>All announcements →</a></div>{news.map(item => <NewsItem {...item} />)}</section>
</BaseLayout>

---
import { readFileSync } from 'node:fs';
import { local } from '../../lib/paths';
// Preserve the complete original page. Prefix only relative file links; leave
// fragment links local to the archive. The source file itself stays unchanged.
const source = readFileSync(new URL('../../../index.html', import.meta.url), 'utf8');
const html = source.replace(/<!doctype html>/i, '').replace(/(href|src)="([^"\s]+)"/g, (match, attr, value) => {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/|#)/i.test(value)) return match;
  if (/^(?:\.\/)?Posts\/SEFM_DataMod\/cheddar_updates\.html/.test(value)) return `${attr}="${local('posts/SEFM_DataMod/SEFM_DataMod_2024.html')}"`;
  return `${attr}="${local(value.replace(/^\.\//, ''))}"`;
});
---
<!doctype html><Fragment set:html={html} />

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsTimeline from '../../components/NewsTimeline.astro';
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id));
const years = [...new Set(news.map(item => item.data.date.slice(0, 4)))];
---
<BaseLayout title="News archive" description="Dated research, publication, project and career announcements from Kangfeng (Randall) Ye.">
  <div class="page-heading"><p class="eyebrow">Research & career</p><h1>News archive</h1><p>Research, publications, projects and career updates.</p></div>
  <nav class="anchor-nav" aria-label="News years">{years.map(year => <a href={`#year-${year}`}>{year}</a>)}</nav>
  {years.map(year => <section class="section" aria-labelledby={`year-${year}`}><h2 id={`year-${year}`}>{year}</h2><NewsTimeline items={news.filter(item => item.data.date.startsWith(year))} /></section>)}
</BaseLayout>

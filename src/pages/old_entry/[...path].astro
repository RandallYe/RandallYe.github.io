---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import aliases from '../../data/route-aliases.json';
import { local } from '../../lib/site-paths';
export const getStaticPaths = (() => aliases.map(alias => ({ params: { path: alias.path }, props: { alias } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { alias } = Astro.props;
const destination = local(alias.destination);
---
<!doctype html>
<html lang="en-GB"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta http-equiv="refresh" content={`0;url=${destination}`} /><link rel="canonical" href={new URL(destination, Astro.site)} /><title>{alias.title} | Randall Ye</title></head><body><p>This research page has moved. <a href={destination}>{alias.title}</a>.</p></body></html>

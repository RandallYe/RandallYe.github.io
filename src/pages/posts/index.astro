---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { local } from '../../lib/site-paths';
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout title="Posts" description="Technical notes and conference reports by Kangfeng (Randall) Ye.">
  <div class="page-heading"><p class="eyebrow">Research notes & reports</p><h1>Posts</h1><p>Notes on formal methods, probability and research applications.</p></div>
  <section class="visual-list" aria-label="Posts in reverse chronological order">
    {posts.map(({ id, data }) => <article class="research-detail visual-entry">
      <img class="visual-entry-image" src={local(data.thumbnail.slice(1))} alt={data.thumbnailAlt} loading="lazy" decoding="async" />
      <div class="visual-entry-copy"><p class="eyebrow">{data.dateLabel ?? <time datetime={data.date}>{data.date}</time>}</p><h2><a href={local(`posts/${id}/`)}>{data.title}</a></h2><p>{data.summary}</p><a class="text-link" href={local(`posts/${id}/`)}>Read the post →</a></div>
    </article>)}
  </section>
</BaseLayout>

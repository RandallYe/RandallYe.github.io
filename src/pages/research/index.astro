---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFocus from '../../components/ResearchFocus.astro';
import { getCollection, getEntry } from 'astro:content';
import { local } from '../../lib/site-paths';
import '../../styles/research.css';
const areas = (await getCollection('researchAreas')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const selected = await Promise.all([
  { title: 'UTP & Circus', paper: 'circus-model-checking', venue: 'Formal Aspects of Computing', demo: null, notation: 'P ⊑ Q', path: 'concurrency/#circus', summary: 'Modelling state-rich concurrent systems and verifying them through refinement checking.' },
  { title: 'ProbURel', paper: 'proburel', venue: 'Theoretical Computer Science', demo: 'probabilistic-relations', notation: 'ℙ(X)', path: 'semantics/#proburel', summary: 'Extending relational reasoning to uncertainty, learning and probabilistic programs.' },
  { title: 'RoboChart & PRISM', paper: 'robochart-prism', venue: 'Software and Systems Modeling', demo: 'robochart-prism', notation: 'P ∥ Q', path: 'probability/#robochart-prism', summary: 'From robotic state machines to automated probabilistic verification and quantitative properties.' },
].map(async work => ({ ...work, publication: await getEntry('publications', work.paper), demonstration: work.demo ? await getEntry('demos', work.demo) : undefined })));
---
<BaseLayout title="Research" description="Modelling, verification, development and quantification of state-rich reactive, concurrent and distributed systems using UTP, Circus, CSP and Z.">
  <ResearchFocus />
  <section class="section" aria-labelledby="selected-research-title">
    <div class="section-heading"><div><p class="eyebrow">Theory into practice · Co-authored work</p><h2 id="selected-research-title">Selected contributions</h2></div><a href={local('publications/')}>All publications →</a></div>
    <div class="research-selected-grid">{selected.map((work, index) => <article class="research-selected">
      <div class="research-selected-preview">
        {work.demonstration?.data.thumbnail ? <img src={local(work.demonstration.data.thumbnail)} alt={work.demonstration.data.thumbnailAlt} width="720" height="450" loading="lazy" decoding="async" /> : <div class="research-foundation-preview" aria-hidden="true"><span>UTP / CIRCUS</span><strong>{work.notation}</strong><span>STATE · CONCURRENCY · REFINEMENT</span></div>}
        <span class="research-selected-index" aria-hidden="true">0{index + 1}</span>
      </div>
      <div class="research-selected-copy"><p class="eyebrow">{work.publication?.data.year} · {work.venue}</p><h3><a href={local(`research/${work.path}`)}>{work.title}</a></h3><p>{work.summary}</p><p class="research-authors">{work.publication?.data.authors}</p><a class="text-link" href={local(`research/${work.path}`)}>Explore the contribution →</a></div>
    </article>)}</div>
  </section>
  <section class="section" id="areas" aria-labelledby="research-areas-title">
    <div class="section-heading"><div><p class="eyebrow">Contributions to one research theme</p><h2 id="research-areas-title">Foundations, methods & applications</h2></div><a class="text-link" href={local('research/interests/')}>Research interests and summary →</a></div>
    {areas.map(({ id, data }) => <article class="research-area-overview" id={id}>
      <div class="research-area-marker" aria-hidden="true"><span>0{data.order + 1}</span><strong>{data.notation}</strong></div>
      <div><h3><a href={local(`research/${id}/`)}>{data.title}</a></h3><p class="research-overview-question">{data.question}</p><p>{data.summary}</p><a class="text-link" href={local(`research/${id}/`)}>Explore these contributions →</a></div>
      <ul class="research-work-index" aria-label={`Contributions in ${data.shortTitle}`}>{data.contributions.map(work => <li><a href={local(`research/${id}/#${work.id}`)}>{work.title}<span aria-hidden="true">↗</span></a></li>)}</ul>
    </article>)}
  </section>
  <section class="section" aria-labelledby="research-cases-title">
    <div class="section-heading"><div><p class="eyebrow">Models behind the methods</p><h2 id="research-cases-title">From theory to case studies</h2></div></div>
    <div class="research-case-grid">
      <figure class="research-case"><a href={local('pics/uvc_human.png')} aria-label="View the UV light-treatment robot human-state model at full size"><img src={local('pics/uvc_human.png')} alt="RoboChart human-state model with probabilistic transitions between out-of-range, green, yellow and red zones." width="2346" height="1732" loading="lazy" decoding="async" /></a><figcaption><p class="eyebrow">Robotic safety · RoboChart</p><h3>Uncertainty around a UV light-treatment robot</h3><p>The human-state model represents uncertain movement between zones around the robot. The co-authored agriculture-robot study connects probabilistic modelling with safety assurance.</p><a href={local('research/probability/#robochart-prism')}>Modelling and verification →</a></figcaption></figure>
      <figure class="research-case"><a href={local('pics/PAL_use_case.png')} aria-label="View the hospital intralogistics activity diagram at full size"><img src={local('pics/PAL_use_case.png')} alt="Hospital intralogistics activity diagram with two concurrent robot delivery paths, reliability, duration and probabilistic flow annotations." width="3226" height="1360" loading="lazy" decoding="async" /></a><figcaption><p class="eyebrow">Quantitative workflows · UML</p><h3>Hospital intralogistics</h3><p>Reliability, duration and probabilistic annotations describe a robot delivery workflow. Quantitative analysis connects the activity diagram to Markov models and controller synthesis.</p><a href={local('research/probability/#activity-diagrams')}>Activity diagrams and analysis →</a></figcaption></figure>
    </div>
  </section>
  <section class="section" id="projects"><div class="section-heading"><div><p class="eyebrow">Collaborations & research settings</p><h2>Project history</h2></div></div><p>Dates describe my participation in each project.</p><div class="research-project-links">{projects.map(({ id, data }) => <a href={local(`research/projects/${id}/`)}><strong>{data.title}</strong><span>{data.period}</span></a>)}</div></section>
</BaseLayout>

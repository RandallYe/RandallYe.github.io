---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { research } from '../../data/research';
import { local } from '../../lib/site-paths';
---
<BaseLayout title="Research" description="Research in formal semantics, concurrency, security protocols, probabilistic verification and model-based engineering.">
  <div class="page-heading"><p class="eyebrow">Foundations & applications</p><h1>Research</h1><p>Precise mathematical models, mechanised reasoning, and tools for understanding complex software behaviour.</p></div>
  <nav class="anchor-nav" aria-label="Research themes">{research.map(theme => <a href={`#${theme.id}`}>{theme.title}</a>)}</nav>
  {research.map(theme => <section class="research-detail prose" id={theme.id}><h2>{theme.title}</h2><p>{theme.summary}</p><p>{theme.detail}</p><a href={theme.url}>Explore the research resources ↗</a>{theme.id === 'semantics' && <p><a href={local('tools/probabilistic-relations/')}>Watch the probabilistic-relations walkthrough →</a></p>}</section>)}
  <section class="section prose"><h2>Contributions in context</h2><p>This research includes collaborations with colleagues at York and beyond. Publication records name co-authors. Contributions to Isabelle/UTP concern selected reactive-design and interaction-tree developments; I primarily use the framework rather than develop it.</p><a href={local('legacy/#insresearch-interests-and-summaryins')}>Read the complete original research descriptions →</a></section>
</BaseLayout>

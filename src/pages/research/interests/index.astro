---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { local } from '../../../lib/site-paths';
import '../../../styles/research.css';
const areas = (await getCollection('researchAreas')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Research interests and summary" description="One-page summary of research interests: UTP and Circus, probabilistic semantics and verification, formal specification languages, graphical notations and security protocol verification.">
  <div class="research-area-heading">
    <a class="back-link" href={local('research/')}>← Research overview</a>
    <p class="eyebrow">Research · One-page summary</p>
    <h1 id="insresearch-interests-and-summaryins">Research interests and summary</h1>
    <p>Formal verification, formal semantics, probabilistic programming languages, probabilistic model checking and theorem proving, model-based software engineering, cyber-physical systems, cryptographic security protocols and tool development.</p>
  </div>
  <nav class="anchor-nav" aria-label="Research interests">{areas.map(area => <a href={`#${area.id}`}>{area.data.shortTitle}</a>)}</nav>
  {areas.map(area => <section class="section" id={area.id} aria-labelledby={`${area.id}-title`}>
    <div class="section-heading"><div><p class="eyebrow">Strand 0{area.data.order + 1}</p><h2 id={`${area.id}-title`}>{area.data.title}</h2><p>{area.data.summary}</p></div><a class="text-link" href={local(`research/${area.id}/`)}>Full detail →</a></div>
    <ul class="research-interests">{area.data.contributions.map(work => <li>
      <h3><a href={local(`research/${area.id}/#${work.id}`)}>{work.title}</a></h3>
      <p>{work.summary}</p>
      {work.resources.length > 0 && <p class="research-interest-links">{work.resources.map(resource => <a href={resource.url.startsWith('/') ? local(resource.url) : resource.url}>{resource.label}</a>)}</p>}
    </li>)}</ul>
  </section>)}
</BaseLayout>

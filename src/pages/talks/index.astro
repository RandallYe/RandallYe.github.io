---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { local } from '../../lib/site-paths';

const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const href = (url: string) => url.startsWith('/') ? local(url.slice(1)) : url;
---
<BaseLayout title="Talks & presentations" description="Conference presentations, seminars, tutorials and public talks, with preserved slides and selected recordings.">
  <div class="page-heading">
    <p class="eyebrow">Presentations & conversations</p>
    <h1>Talks</h1>
    <p>Research shared through conference presentations, seminars, tutorials and public events. Rehearsals are grouped with their associated conference talk.</p>
  </div>
  <section class="talk-list" aria-label="Talks in reverse chronological order">
    {talks.map(({ id, data }) => (
      <article class="research-detail talk-entry" id={id}>
        <p class="eyebrow"><time datetime={data.date}>{new Date(`${data.date}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time> · {data.event}</p>
        <h2>{data.title}</h2>
        <p>{data.description}</p>
        {data.recording && <div class="talk-recording">
          <h3>{data.recordingTitle ?? 'Recording'}</h3>
          <video controls preload="none" playsinline src={local(data.recording.slice(1))}>
            <a href={local(data.recording.slice(1))}>Download the recording</a>
          </video>
          <p class="video-caption">Video playback has not been independently checked in this build environment. <a href={local(data.recording.slice(1))} download>Download the original file</a>.</p>
        </div>}
        {data.rehearsals.length > 0 && <details class="talk-rehearsals">
          <summary>Related rehearsals ({data.rehearsals.length})</summary>
          <ul>{data.rehearsals.map(item => <li><time datetime={item.date}>{item.date}</time> — {item.label}: {item.title}</li>)}</ul>
        </details>}
        {data.resources.length > 0 && <ul class="resource-links" aria-label={`Resources for ${data.title}`}>
          {data.resources.map(resource => <li><a href={href(resource.url)}>{resource.label} <span aria-hidden="true">↗</span></a></li>)}
        </ul>}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .talk-list { display: grid; gap: 1.15rem; }
  .talk-entry { scroll-margin-top: 6rem; }
  .talk-entry h2 { max-width: 850px; }
  .talk-entry > .eyebrow { margin-bottom: .55rem; }
  .talk-recording { max-width: 820px; margin: 1.5rem 0; }
  .talk-recording h3 { font-size: 1rem; }
  .talk-recording video { display: block; width: 100%; max-height: 70vh; background: #111; }
  .talk-rehearsals { margin-top: 1rem; }
  .talk-rehearsals summary { cursor: pointer; font-weight: 600; }
  .talk-rehearsals ul { padding-left: 1.4rem; }
  .talk-rehearsals li { margin: .45rem 0; }
</style>

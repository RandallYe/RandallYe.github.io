---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import { local } from '../../lib/paths';
export const getStaticPaths = (async () => {
  const demos = await getCollection('demos');
  return demos.map(demo => ({ params: { slug: demo.data.slug }, props: { demo } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { demo } = Astro.props;
const d = demo.data;
const { Content } = await render(demo);
---
<BaseLayout title={d.title} description={d.summary}>
  <a class="back-link" href={local('tools/')}>← Tools & Demos</a>
  <div class="page-heading"><p class="eyebrow">{d.researchArea} · Recorded demonstration</p><h1>{d.title}</h1><p>{d.subtitle}</p></div>
  <section class="prose"><h2>The problem</h2><p>{d.problem}</p><h2>The approach</h2><p>{d.method}</p></section>
  <section class="section" id="recording"><div class="section-heading"><div><p class="eyebrow">See the research</p><h2>Watch the demonstration</h2></div></div>{d.videoUrl ? <VideoEmbed url={d.videoUrl} title={d.title} note={d.mediaNote} /> : <p class="notice">A recording has not yet been located. Explore the source resources below.</p>}</section>
  <section class="section prose"><h2>What this demonstrates</h2><ol class="step-list">{d.whatVisitorsSee.map(step => <li><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol><p class="notice">{d.resultsOrLimitations}</p></section>
  <section class="section" id="examples"><div class="section-heading"><div><p class="eyebrow">Specifications in the source repository</p><h2>Two protocol examples</h2></div></div><div class="grid example-grid">{d.exampleLinks.map((example, index) => <article class="tool-card"><p class="eyebrow">Example 0{index + 1}</p><h3>{index === 0 ? 'Needham–Schroeder public-key protocol' : 'Diffie–Hellman key agreement'}</h3><p>{index === 0 ? 'Explore the public-key protocol specification in the early-framework model collection. Related variants are documented in the repository.' : 'Inspect the key-agreement specification and its explicit intruder model. The repository also documents a digital-signature variant.'}</p><a class="text-link" href={example.url}>Read the Isabelle/HOL specification ↗</a></article>)}</div></section>
  <section class="section prose"><Content /></section>
  <section class="section"><h2>Paper, source & slides</h2><ResourceLinks links={[...d.paperLinks, ...d.sourceLinks, ...d.slidesLinks]} /></section>
</BaseLayout>

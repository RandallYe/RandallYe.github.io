---
import { getCollection, getEntries, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalVideo from '../../components/LocalVideo.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import { local } from '../../lib/site-paths';
export const getStaticPaths = (async () => {
  const demos = await getCollection('demos');
  return demos.map(demo => ({ params: { slug: demo.data.slug }, props: { demo } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { demo } = Astro.props;
const d = demo.data;
const videos = d.media.filter(media => media.kind === 'video');
const figures = d.media.filter(media => media.kind === 'image');
const papers = await getEntries(d.relatedPublications);
const { Content } = await render(demo);
---
<BaseLayout title={d.title} description={d.summary}>
  <a class="back-link" href={local('tools/')}>← Tools & Demos</a>
  <div class="page-heading">
    <p class="eyebrow">{d.researchArea} · {d.category === 'engineering-case-study' ? 'Engineering case study' : 'Recorded demonstration'}</p>
    <h1>{d.title}</h1><p>{d.subtitle}</p>
    {d.provenance && <p class="source-date">Originally published <time datetime={d.provenance.originalDate}>{new Date(`${d.provenance.originalDate}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>}
  </div>
  <section class="prose"><h2>The problem</h2><p>{d.problem}</p><h2>The approach</h2><p>{d.method}</p></section>
  <section class="section" id="recording">
    <div class="section-heading"><div><p class="eyebrow">See the research</p><h2>Watch the demonstration</h2></div></div>
    {videos.map((video, index) => <LocalVideo {...video} note={d.mediaNote} id={`recording-${index}`} />)}
    {videos.length === 0 && (d.videoUrl ? <VideoEmbed url={d.videoUrl} title={d.title} note={d.mediaNote} /> : <p class="notice">A recording has not yet been located. Explore the source resources below.</p>)}
  </section>
  <section class="section prose"><h2>What this demonstrates</h2><ol class="step-list">{d.whatVisitorsSee.map(step => <li><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol><p class="notice">{d.resultsOrLimitations}</p></section>
  {d.exampleLinks.length > 0 && <section class="section" id="examples">
    <div class="section-heading"><div><p class="eyebrow">Explore the source material</p><h2>{d.examplesHeading}</h2></div></div>
    <div class="grid example-grid">{d.exampleLinks.map((example, index) => <article class="tool-card"><p class="eyebrow">Example 0{index + 1}</p><h3>{example.label}</h3>{example.description && <p>{example.description}</p>}<a class="text-link" href={local(example.url)}>Explore the specification and source ↗</a></article>)}</div>
  </section>}
  {figures.length > 0 && <section class="section"><h2>Models & supporting figures</h2><div class="demo-figures">{figures.map(figure => <figure><a href={local(figure.src)}><img src={local(figure.src)} alt={figure.alt || figure.title} loading="lazy" decoding="async" /></a><figcaption><strong>{figure.title}</strong><p>{figure.caption}</p></figcaption></figure>)}</div></section>}
  <section class="section prose"><Content /></section>
  {papers.length > 0 && <section class="section prose"><h2>Related publications</h2>{papers.map(paper => <p><a href={local(`publications/#${paper.id}`)}>{paper.data.title}</a><br /><span class="muted">{paper.data.authors} · {paper.data.year}</span></p>)}</section>}
  <section class="section"><h2>Research resources & references</h2><ResourceLinks links={[...d.paperLinks, ...d.sourceLinks, ...d.slidesLinks]} /></section>
</BaseLayout>
<style>
  .page-heading .source-date { font-size: .85rem; color: var(--muted); }
  .demo-figures { display: grid; gap: 2rem; margin-top: 1.5rem; }
  .demo-figures figure { margin: 0; }
  .demo-figures img { display: block; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 5px; background: white; }
  .demo-figures figcaption { margin-top: .75rem; color: var(--muted); font-size: .85rem; }
  .demo-figures figcaption p { margin: .3rem 0; }
</style>

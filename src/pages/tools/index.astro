---
import { getCollection } from 'astro:content';
import FeaturedDemo from '../../components/FeaturedDemo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCards from '../../components/ToolCards.astro';
const demos = (await getCollection('demos', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Tools & Demos" description="Explore research software, mechanised theories and demonstrations of formal verification.">
  <div class="page-heading"><p class="eyebrow">Research you can explore</p><h1>Tools & Demos</h1><p>Implementations and examples that connect formal foundations with practical exploration.</p></div>
  {demos.map(demo => <FeaturedDemo demo={demo} />)}
  <ToolCards />
</BaseLayout>
